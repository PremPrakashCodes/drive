# Postgres connection string (Neon). Used by the app and by drizzle-kit.
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth: the secret that signs sessions (openssl rand -base64 32), and the app's base URL,
# used for auth callbacks and invitation links.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Resend API key for verification, password-reset, and invitation emails.
RESEND_API_KEY=""

# Optional values stay commented out: env.ts treats an empty string as set, and rejects it.

# Sender address. Defaults to Drive <onboarding@resend.dev>, which only delivers to your own
# Resend account's email; use an address on a domain you've verified in Resend.
EMAIL_FROM="Drive <drive@example.com>"

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts storage provider credentials; needed before connecting a bucket.
# Changing it makes saved keys unreadable.
STORAGE_ENCRYPTION_KEY=""

# Authorizes Vercel Cron requests (daily trash cleanup), at least 16 characters: openssl rand -hex 32
CRON_SECRET=""
