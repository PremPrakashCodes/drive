{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/predeploy.mjs && npm run db:migrate && next build",
  "crons": [
    {
      "path": "/api/cron/empty-trash",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/reclaim-orphans",
      "schedule": "0 3 * * *"
    }
  ]
}
